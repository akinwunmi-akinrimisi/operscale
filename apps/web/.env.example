# apps/web/.env.example
#
# Production values live at /etc/operscale-calendar/web.env on the VPS (chmod 600).
# Source of truth: docs/deployment.md.
#
# RULE: This file may ONLY contain NEXT_PUBLIC_* variables (browser-safe) and
# strictly server-only variables that are read at runtime by the Next.js server.
# Any *_KEY or *_SECRET that appears here MUST be safe to ship to the browser.
# CI runs scripts/check-env-scoping.sh to enforce this on every PR.

NODE_ENV=development

# --- Supabase (browser + server) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://supabase.operscale.cloud
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Paystack (browser inline checkout key — public by design) --------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Brand placeholder (until Day 15 lock) ----------------------------------
NEXT_PUBLIC_BRAND_NAME=Operscale
NEXT_PUBLIC_BRAND_DOMAIN=operscale.cloud
NEXT_PUBLIC_FOUNDER_WHATSAPP=

# --- Observability ----------------------------------------------------------
# Single DSN per docs/architecture.md "Production environment variables".
# The @sentry/nextjs SDK reads SENTRY_DSN on the server runtime; client-side
# error capture is handled via the Sentry Next.js auto-instrumentation that
# inlines the DSN at build time from this same variable. If we ever need a
# distinct browser DSN, that's a deviation from architecture.md and needs an ADR.
SENTRY_DSN=
