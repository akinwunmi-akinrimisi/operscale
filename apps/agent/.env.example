# apps/agent/.env.example
#
# Production values live at /etc/operscale-calendar/agent.env on the VPS (chmod 600).
# Source of truth: docs/architecture.md "Production environment variables" + docs/deployment.md.
#
# Most variables here are SERVER-ONLY. Two NEXT_PUBLIC_* names appear at the
# bottom (BRAND_DOMAIN, FOUNDER_WHATSAPP) — these are mirrored from web.env per
# architecture.md so the agent renders email/WhatsApp template bodies with the
# same values the browser uses. The NEXT_PUBLIC_ prefix is a naming convention
# in this case, not a browser-export — the agent never serves a client bundle.

NODE_ENV=development

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://supabase.operscale.cloud
# SECURITY: service-role key bypasses RLS. Never expose to client.
# Per CLAUDE.md "API keys and secrets" rule 3: never imported from apps/web/src/app/.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (brief analysis) ----------------------------------------------
# Model: claude-opus-4-7. See docs/specs/ai-brief-analysis.md.
ANTHROPIC_API_KEY=

# --- Paystack (NGN payments) -------------------------------------------------
# Test keys until Day 15 of build (docs/implementation.md), then live keys.
# Webhook signature uses the same secret key (HMAC-SHA512 on raw body).
PAYSTACK_SECRET_KEY=

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
# Webhook signing secret (Svix). Used by /v1/webhook/resend-inbound to verify
# bounce/complaint/delivered events. Configured per webhook in the Resend dashboard.
# See docs/specs/email-templates.md "Bounce/Complaint" + "Inbound Handling".
RESEND_WEBHOOK_SECRET=

# --- Evolution API (WhatsApp) ------------------------------------------------
# Self-hosted on the same VPS, reached via Docker network internal hostname.
EVOLUTION_API_BASE=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=operscale-calendar

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Pino log level for apps/agent/src/lib/logger.ts. Defaults: 'info' in production,
# 'debug' otherwise. Override here for one-off forensic runs without redeploying.
LOG_LEVEL=

# --- Brand placeholder (until Day 15 lock) -----------------------------------
# These mirror the same vars in apps/web/.env.example because the agent renders
# email + WhatsApp template bodies and needs to know the brand domain.
NEXT_PUBLIC_BRAND_DOMAIN=operscale.cloud
NEXT_PUBLIC_FOUNDER_WHATSAPP=
