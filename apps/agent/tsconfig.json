{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@operscale-calendar/agent/lib/*": ["./src/lib/*"],
      "@operscale-calendar/web/emails/*": ["../web/src/emails/*"],
      "@react-email/render": ["../web/node_modules/@react-email/render/dist/node/index.d.mts"]
    }
  },
  "include": ["next-env.d.ts", "vitest.config.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
